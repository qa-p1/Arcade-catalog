{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/qa-p1/Arcade-catalog/main/schema/catalog.schema.json",
  "title": "Arcade catalog",
  "type": "object",
  "required": [
    "schema",
    "updated",
    "apps",
    "tools",
    "bundles",
    "browser"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "updated": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "apps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/app"
      }
    },
    "tools": {
      "$ref": "#/$defs/tools"
    },
    "bundles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/bundle"
      }
    },
    "rules": {
      "type": "object",
      "description": "Optional corrections to offers (Arcade Link SPEC §5.5), keyed by action reference <app-id>/<action-id>. Older apps ignore it.",
      "additionalProperties": false,
      "properties": {
        "hide": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^arcade\\.[a-z][a-z0-9-]*/\\S+$"
          },
          "description": "Never offered."
        },
        "rename": {
          "type": "object",
          "propertyNames": {
            "pattern": "^arcade\\.[a-z][a-z0-9-]*/\\S+$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "description": "Shown with this title."
        },
        "boost": {
          "type": "object",
          "propertyNames": {
            "pattern": "^arcade\\.[a-z][a-z0-9-]*/\\S+$"
          },
          "additionalProperties": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "integer",
              "minimum": -100,
              "maximum": 100
            }
          },
          "description": "Points added to the rank for offered types a pattern takes."
        },
        "jobs": {
          "type": "object",
          "propertyNames": {
            "pattern": "^arcade\\.[a-z][a-z0-9-]*/\\S+$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "description": "Treated as doing this job."
        }
      }
    },
    "browser": {
      "type": "object",
      "description": "Where the Arcade browser extension adds its own buttons to pages (Arcade-browser). Selectors are data, so a site's layout change is fixed here, not by releasing the extension. Older apps ignore it.",
      "additionalProperties": false,
      "properties": {
        "sites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/browserSite"
          }
        },
        "hover": {
          "$ref": "#/$defs/browserHover"
        }
      }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
    },
    "repo": {
      "type": "string",
      "pattern": "^qa-p1/[^/?#]+$"
    },
    "icon": {
      "type": "string",
      "pattern": "^icons/[a-z0-9][a-z0-9.-]*\\.(svg|png)$"
    },
    "app": {
      "type": "object",
      "required": [
        "id",
        "name",
        "repo",
        "pitch",
        "description",
        "category",
        "icon",
        "screenshots",
        "platforms",
        "linkProtocol",
        "minTools",
        "docs",
        "resident",
        "homepage"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^arcade\\.[a-z][a-z0-9-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "repo": {
          "$ref": "#/$defs/repo"
        },
        "pitch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "tagline": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[^\\n]*[.!?]$",
          "description": "The app's one-line README tagline, used unchanged by Tools for cards, onboarding and tray tooltips. Optional; older Tools ignore it."
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": [
            "files",
            "capture",
            "clipboard",
            "launcher",
            "toolbox"
          ]
        },
        "icon": {
          "$ref": "#/$defs/icon"
        },
        "screenshots": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://(raw\\.githubusercontent\\.com|github\\.com)(/|$)"
          }
        },
        "platforms": {
          "type": "object",
          "required": [
            "linux",
            "windows",
            "macos"
          ],
          "properties": {
            "linux": {
              "$ref": "#/$defs/platformStatus"
            },
            "windows": {
              "$ref": "#/$defs/platformStatus"
            },
            "macos": {
              "$ref": "#/$defs/platformStatus"
            }
          },
          "additionalProperties": false
        },
        "linkProtocol": {
          "const": [
            1
          ]
        },
        "minTools": {
          "$ref": "#/$defs/semver"
        },
        "docs": {
          "type": "string",
          "minLength": 1
        },
        "resident": {
          "type": "boolean"
        },
        "homepage": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com(/|$)"
        },
        "bad": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/badRelease"
          },
          "uniqueItems": true
        },
        "pairs": {
          "type": "object",
          "description": "Optional: one sentence per peer app id saying what this app and that peer do together (Arcade Link SPEC §3.1), shown on Connected apps pages. Older apps ignore it.",
          "propertyNames": {
            "pattern": "^arcade\\.[a-z][a-z0-9-]*$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100,
            "pattern": "^[^\\n]*\\.$"
          }
        }
      }
    },
    "platformStatus": {
      "enum": [
        "verified",
        "ci",
        "build-only",
        "unsupported"
      ]
    },
    "tools": {
      "type": "object",
      "required": [
        "id",
        "name",
        "repo",
        "minTools",
        "icon"
      ],
      "properties": {
        "id": {
          "const": "arcade.tools"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "tagline": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[^\\n]*[.!?]$",
          "description": "The app's one-line README tagline, used unchanged by Tools for cards, onboarding and tray tooltips. Optional; older Tools ignore it."
        },
        "repo": {
          "$ref": "#/$defs/repo"
        },
        "minTools": {
          "$ref": "#/$defs/semver"
        },
        "icon": {
          "$ref": "#/$defs/icon"
        },
        "bad": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/badRelease"
          },
          "uniqueItems": true
        },
        "pairs": {
          "type": "object",
          "description": "Optional: one sentence per peer app id saying what this app and that peer do together (Arcade Link SPEC §3.1), shown on Connected apps pages. Older apps ignore it.",
          "propertyNames": {
            "pattern": "^arcade\\.[a-z][a-z0-9-]*$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100,
            "pattern": "^[^\\n]*\\.$"
          }
        }
      }
    },
    "bundle": {
      "type": "object",
      "required": [
        "id",
        "title",
        "description",
        "apps"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "apps": {
          "oneOf": [
            {
              "const": "*"
            },
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^arcade\\.[a-z][a-z0-9-]*$"
              }
            }
          ]
        }
      }
    },
    "badRelease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "reason"
      ],
      "description": "A withdrawn release. Tools never offers it and tells anyone who has it installed to roll back.",
      "properties": {
        "tag": {
          "type": "string",
          "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(-(nightly\\.[0-9]{8}\\.[0-9]+|rc\\.[0-9]+))?$",
          "description": "The GitHub release tag, e.g. v1.2.0 or v1.3.0-nightly.20261107.1."
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "One sentence shown to users."
        }
      }
    },
    "browserMatch": {
      "type": "string",
      "pattern": "^(https?|\\*)://(\\*|\\*\\.[^/*:]+|[^/*:]+)(:[0-9]+)?/.*$",
      "description": "A WebExtension match pattern, such as https://www.youtube.com/*."
    },
    "browserSite": {
      "type": "object",
      "required": [
        "id",
        "name",
        "matches",
        "buttons"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "matches": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/browserMatch"
          }
        },
        "buttons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/browserButton"
          }
        }
      }
    },
    "browserButton": {
      "type": "object",
      "required": [
        "id",
        "label",
        "action",
        "anchors"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24
        },
        "action": {
          "type": "string",
          "pattern": "^arcade\\.[a-z][a-z0-9-]*/\\S+$",
          "description": "The action the button runs, <app-id>/<action-id>; its options form opens first unless it is one click."
        },
        "input": {
          "enum": [
            "page"
          ],
          "default": "page",
          "description": "What the action gets: the page's address."
        },
        "anchors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": "CSS selectors tried in order; the first one on the page places the button."
        },
        "position": {
          "enum": [
            "append",
            "prepend",
            "before",
            "after"
          ],
          "default": "append"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "A regular expression the page's path (with its query) must match, such as ^/watch."
        }
      }
    },
    "browserHover": {
      "type": "object",
      "additionalProperties": false,
      "description": "The small Arcade button over pictures and videos (a setting in the extension, on by default).",
      "properties": {
        "minWidth": {
          "type": "integer",
          "minimum": 16,
          "maximum": 2000,
          "default": 120
        },
        "minHeight": {
          "type": "integer",
          "minimum": 16,
          "maximum": 2000,
          "default": 80
        },
        "video": {
          "type": "object",
          "required": [
            "label",
            "action"
          ],
          "additionalProperties": false,
          "description": "What the button over a video does: an action on the page's address.",
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 24
            },
            "action": {
              "type": "string",
              "pattern": "^arcade\\.[a-z][a-z0-9-]*/\\S+$"
            }
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/browserMatch"
          },
          "description": "Pages where no hover button shows."
        }
      }
    }
  }
}
